{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "context", "nodes"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "context": {"type": "object", "minProperties": 1},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "schema_version", "unit"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "schema_version": {"$ref": "#/$defs/version"},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["node", "output", "contract"],
      "properties": {"node": {"$ref": "#/$defs/name"}, "output": {"const": "result"},
                     "contract": {"$ref": "#/$defs/contract"}}
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "operation", "version", "parameters", "inputs", "output_contract"],
      "properties": {
        "id": {"$ref": "#/$defs/name"}, "operation": {"$ref": "#/$defs/name"},
        "version": {"$ref": "#/$defs/version"}, "parameters": {"type": "object"},
        "inputs": {"type": "object", "maxProperties": 32, "propertyNames": {"$ref": "#/$defs/name"},
                   "additionalProperties": {"$ref": "#/$defs/input"}},
        "output_contract": {"$ref": "#/$defs/contract"}
      }
    }
  }
}
